{
  "id": "intrigue",
  "name": "Dominion — Intrigue",
  "version": 1,
  "schemaVersion": 2,
  "baseCards": [],
  "cards": [
    {
      "id": "cour",
      "name": "Cour",
      "cost": 2,
      "types": ["Action"],
      "image": "cour.png",
      "text": "+3 Cartes\n\nPlacez une carte de votre main sur votre pioche.",
      "abilities": [
        {
          "when": "play",
          "effects": [
            { "op": "draw", "target": "self", "amount": 3 },
            { "op": "choose_cards", "target": "self", "zone": "hand", "min": 1, "max": 1, "prompt": "Placez une carte de votre main sur votre pioche." },
            { "op": "move_selected", "target": "self", "sourceZone": "hand", "destinationZone": "deck" }
          ]
        }
      ]
    },
    {
      "id": "rodeuse",
      "name": "Rôdeuse",
      "cost": 2,
      "types": ["Action"],
      "image": "rodeuse.png",
      "text": "+1 Action\n\nChoisissez : écartez une carte Action de la Réserve ; ou recevez une carte Action parmi les cartes écartées.",
      "abilities": [
        {
          "when": "play",
          "effects": [
            { "op": "add_resource", "target": "self", "resource": "actions", "amount": 1 },
            { "op": "choose_supply", "target": "self", "min": 0, "max": 1, "cardType": "Action", "prompt": "Choisissez une carte Action de la Réserve à écarter, ou passez pour recevoir une carte Action parmi les cartes écartées." },
            { "op": "trash_selected_supply", "target": "self", "requiresLastSelection": true },
            { "op": "choose_cards", "target": "self", "zone": "trash", "min": 1, "max": 1, "cardType": "Action", "allowNoEligible": true, "requiresNoLastSelection": true, "prompt": "Recevez une carte Action parmi les cartes écartées." },
            { "op": "gain_selected_trash", "target": "self", "destinationZone": "discard" }
          ]
        }
      ]
    },
    {
      "id": "pion",
      "name": "Pion",
      "cost": 2,
      "types": ["Action"],
      "image": "pion.png",
      "text": "Choisissez deux options différentes :\n+1 Carte\n+1 Action\n+1 Achat\n+1 🪙",
      "abilities": [
        {
          "when": "play",
          "effects": [
            {
              "op": "choose_options",
              "target": "self",
              "min": 2,
              "max": 2,
              "prompt": "Choisissez deux options différentes.",
              "options": [
                { "id": "card", "label": "+1 Carte" },
                { "id": "action", "label": "+1 Action" },
                { "id": "buy", "label": "+1 Achat" },
                { "id": "coin", "label": "+1 🪙" }
              ]
            },
            { "op": "draw", "target": "self", "amount": 1, "requiresSelectedOption": "card" },
            { "op": "add_resource", "target": "self", "resource": "actions", "amount": 1, "requiresSelectedOption": "action" },
            { "op": "add_resource", "target": "self", "resource": "buys", "amount": 1, "requiresSelectedOption": "buy" },
            { "op": "add_resource", "target": "self", "resource": "coins", "amount": 1, "requiresSelectedOption": "coin" }
          ]
        }
      ]
    }
  ]
}
